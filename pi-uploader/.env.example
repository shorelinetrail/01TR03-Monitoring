# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Upload interval in seconds
UPLOAD_INTERVAL=5

# Storage bucket name (must be created in Supabase dashboard)
BUCKET_NAME=camera-snapshots

# Camera 1 Configuration
CAM1_TYPE=reolink
CAM1_HOST=192.168.0.100
CAM1_USERNAME=admin
CAM1_PASSWORD=your-password

# Camera 2 Configuration (optional)
CAM2_TYPE=reolink
CAM2_HOST=192.168.0.101
CAM2_USERNAME=admin
CAM2_PASSWORD=your-password
